# Production release signing configuration.
#
# This file is NOT version-controlled (see .gitignore). Each release engineer
# generates their own keystore and updates this file before publishing.
#
# To create a new keystore (Linux/macOS):
#   keytool -genkeypair -v -keystore my-upload-key.keystore \
#       -alias my-key-alias -keyalg RSA -keysize 2046 -validity 10000
#
# On Windows, escape drive-letter backslashes:
#   C\:\\path\\to\\my-upload-key.keystore

MYAPP_STORE_FILE=
MYAPP_STORE_PASSWORD=
MYAPP_KEY_ALIAS=
MYAPP_KEY_PASSWORD=
