<resources>
    <style name="Theme.KeyVault" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
    </style>

    <!-- Initial launch theme: shows the splash background while Compose starts. -->
    <style name="Theme.KeyVault.Splash" parent="Theme.KeyVault">
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
