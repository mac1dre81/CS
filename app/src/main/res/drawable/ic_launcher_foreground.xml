<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        Key icon with a wide, flat bow (traditional key-handle silhouette)
        to avoid the phallic appearance of the original circular bow.

        Content is scaled to 80% and centered within the adaptive-icon "safe zone"
        (66dp / 108dp ≈ 61% of the viewport, centred at 12,12). Without this
        scaling the key icon fills ~90% of the viewport height, causing launchers
        to clip the bow and teeth — the icon appears zoomed / cropped.
        Pivot is the visual centre of the key artwork (x=12, y=12.4).
    -->
    <group
        android:pivotX="12"
        android:pivotY="12.4"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <!-- key bow — wide rounded rectangle (key handle) -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M8,4 H16 A1,1 0 0,1 17,5 V6 A1,1 0 0,1 16,7 H8 A1,1 0 0,1 7,6 V5 A1,1 0 0,1 8,4 Z" />
        <!-- shaft -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M10.5,7 H13.5 V17.5 H10.5 Z" />
        <!-- biting -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M7,17.5 H17 V19 H7 Z" />
        <!-- teeth -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M7,19.2 H8.8 V21 H7 Z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M15.2,19.2 H17 V21 H15.2 Z" />
    </group>
</vector>
