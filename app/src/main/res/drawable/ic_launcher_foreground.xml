<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!--
        CredStow launcher icon — modern key silhouette.

        Design: rounded-rectangle "key fob" bow + straight shaft + stepped
        biting. The bow is significantly wider than tall (2:1 aspect) to
        avoid any unintended shape associations while remaining instantly
        recognizable as a key at 24dp.

        Content is scaled to 72% and centered within the adaptive-icon safe
        zone (66dp / 108dp ≈ 61% of viewport). This leaves ample clear space
        on all sides so no part of the key is clipped by launcher masks.

        Pivot: visual centre of the 24x24 artwork at (12, 12.5) — slightly
        below geometric centre to account for the lower biting visually
        balancing the upper bow.
    -->
    <group
        android:pivotX="12"
        android:pivotY="12.5"
        android:scaleX="0.72"
        android:scaleY="0.72">
        <!-- Bow: rounded rectangle (key fob style), 8×3 viewport units -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M8,6 A1,1 0 0 0 9,5 L15,5 A1,1 0 0 0 16,6 L16,9 A1,1 0 0 0 15,10 L9,10 A1,1 0 0 0 8,9 Z" />
        <!-- Shaft: straight bar below bow -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M10.5,10 L13.5,10 L13.5,16 L10.5,16 Z" />
        <!-- Biting: single bar with two stepped teeth -->
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M7,16 L17,16 L17,17.5 L7,17.5 Z M8,17.5 L8,19 L10,19 L10,17.5 Z M14,17.5 L14,19 L16,19 L16,17.5 Z" />
    </group>
</vector>
