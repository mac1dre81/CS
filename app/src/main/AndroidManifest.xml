<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- AdMob needs network access to fetch banner ads. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Required to use Google Play Billing for Pro unlock IAP. -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Required on Android 13+ for AdMob to access the Advertising ID. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".CredStowApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CredStow">

        <!-- AdMob application ID.
             The value below MUST exist in res/values/strings.xml as:
                 <string name="admob_test_app_id" translatable="false">ca-app-pub-3940256099942544~3347511713</string>
             The sample ID above is Google's official test App ID.
             Replace with your real AdMob App ID (ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY)
             before publishing to the Play Store. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="@string/admob_test_app_id" />

        <!-- Displays the bundled (offline) privacy policy in a self-contained WebView. -->
        <activity
            android:name=".ui.PrivacyPolicyActivity"
            android:exported="false"
            android:theme="@style/Theme.CredStow"
            android:parentActivityName=".MainActivity" />

        <!-- Displays the bundled (offline) data-deletion instructions in a self-contained WebView. -->
        <activity
            android:name=".ui.DataDeletionActivity"
            android:exported="false"
            android:theme="@style/Theme.CredStow"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.CredStow"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile for one-tap key copying -->
        <service
            android:name=".ui.QuickSettingsTileService"
            android:icon="@drawable/ic_qs_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Lightweight key picker launched from the QS tile -->
        <activity
            android:name=".ui.TileCopyActivity"
            android:exported="false"
            android:theme="@style/Theme.CredStow.Splash" />
    </application>

</manifest>


